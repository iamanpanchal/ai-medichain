generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model access_requests {
  id String @id @default(uuid())
  purpose                                 String
  status                                  AccessStatus @default(pending)
  created_at                              DateTime     @default(now())
  updated_at DateTime @updatedAt
  patient_id                              String
  doctor_id                               String
  users_access_requests_doctor_idTousers  users        @relation("access_requests_doctor_idTousers", fields: [doctor_id], references: [id])
  users_access_requests_patient_idTousers users        @relation("access_requests_patient_idTousers", fields: [patient_id], references: [id])
}

model activities {
  id String @id @default(uuid())
  icon       String
  color      String
  title      String
  meta       String
  created_at DateTime @default(now())
  user_id    String
  users      users    @relation(fields: [user_id], references: [id])
}

model ai_summaries {
  id String @id @default(uuid())
  record_id  String   @unique
  blurb      Json
  findings   Json
  recs       Json
  conditions Json
  model      String   @default("claude-sonnet-4-6")
  created_at DateTime @default(now())
  records    records  @relation(fields: [record_id], references: [id])
}

model records {
  id String @id @default(uuid())
  title         String
  type          RecordType
  source        String
  date          String
  region        Region
  hash          String
  tx            String
  created_at    DateTime        @default(now())
  updated_at DateTime @updatedAt
  patient_id    String
  ai_summaries  ai_summaries?
  users         users           @relation(fields: [patient_id], references: [id])
  shared_access shared_access[]
}

model shared_access {
  id String @id @default(uuid())
  status                                ShareStatus @default(active)
  created_at                            DateTime    @default(now())
  patient_id                            String
  doctor_id                             String
  record_id                             String
  users_shared_access_doctor_idTousers  users       @relation("shared_access_doctor_idTousers", fields: [doctor_id], references: [id])
  users_shared_access_patient_idTousers users       @relation("shared_access_patient_idTousers", fields: [patient_id], references: [id])
  records                               records     @relation(fields: [record_id], references: [id])
}

model users {
  id String @id @default(uuid())
  email                                             String            @unique
  password                                          String
  name                                              String
  role                                              Role
  walletAddress                                     String?
  avatar                                            String?
  initials                                          String?
  created_at                                        DateTime          @default(now())
  updated_at DateTime @updatedAt
  access_requests_access_requests_doctor_idTousers  access_requests[] @relation("access_requests_doctor_idTousers")
  access_requests_access_requests_patient_idTousers access_requests[] @relation("access_requests_patient_idTousers")
  activities                                        activities[]
  records                                           records[]
  shared_access_shared_access_doctor_idTousers      shared_access[]   @relation("shared_access_doctor_idTousers")
  shared_access_shared_access_patient_idTousers     shared_access[]   @relation("shared_access_patient_idTousers")
}

enum AccessStatus {
  pending
  approved
  rejected
}

enum RecordType {
  lab
  xray
  mri
  rx
  ecg
}

enum Region {
  heart
  resp
  digestive
  musco
}

enum Role {
  patient
  doctor
  hospital
}

enum ShareStatus {
  active
  expired
}
