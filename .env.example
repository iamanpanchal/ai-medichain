# ─────────────────────────────────────────────────────────────────────────────
# MediChain — Environment Variables Template
# Copy this file to .env (root) and .env (server/) and fill in your values.
# Never commit .env files to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL of the Node.js backend — used by src/services/auth.ts and aiChat.ts
VITE_API_URL=http://localhost:5000

# ── Backend (Node.js / Express) ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/medichain

# JWT signing secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── AI ────────────────────────────────────────────────────────────────────────
# Anthropic API key — server-side only, never expose as VITE_*
ANTHROPIC_API_KEY=sk-ant-...

# URL of the Python FastAPI microservice (optional — backend falls back to inline Anthropic)
AI_SERVICE_URL=http://localhost:8000

# ── Blockchain (Ethereum / Hardhat) ──────────────────────────────────────────
# JSON-RPC endpoint — use http://localhost:8545 for local Hardhat node
ETHEREUM_RPC_URL=http://localhost:8545

# Address of the deployed MediChain.sol contract
CONTRACT_ADDRESS=0x...

# Private key of the wallet used to anchor records (backend only, never expose)
# For local Hardhat: copy one of the printed test accounts
WALLET_PRIVATE_KEY=0x...

# ── Python AI Microservice ────────────────────────────────────────────────────
# (create ai/.env with the same ANTHROPIC_API_KEY)
